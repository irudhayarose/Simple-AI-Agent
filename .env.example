# Gemini API Key (Get yours for free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name
GEMINI_MODEL=gemini-flash-lite-latest

# Local MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=simple_ai_agent

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_ENCRYPTION_KEY=replace_with_a_generated_fernet_key

# Download this OAuth Desktop client file from Google Cloud Console.
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
